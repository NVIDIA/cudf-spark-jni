/**
 *
 * Jenkinsfile for building cudf-spark-jni on blossom
 *
 */
import hudson.model.Result
import hudson.model.Run
import jenkins.model.CauseOfInterruption.UserInterruption

@Library(['blossom-lib']) _
@Library('blossom-github-lib@master')
import ipp.blossom.*

def githubHelper // blossom github helper
def IMAGE_PREMERGE_CU12
def IMAGE_PREMERGE_CU13
// Metadata selection needs Python, not a JNI toolchain or a GPU.
def cpuImage = pod.getCPUYAML('python:3.11-slim')
def skipped = false
def major_ver // major version extracted from project version
def minor_ver // minor version extracted from project version

pipeline {
    agent {
        kubernetes {
            label "premerge-init-${BUILD_TAG}"
            cloud "${common.CLOUD_NAME}"
            yaml cpuImage
        }
    }

    options {
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '50'))
        skipDefaultCheckout true
        timeout(time: 12, unit: 'HOURS')
    }

    parameters {
        string(name: 'PARALLEL_LEVEL', defaultValue: '18',
            description: 'Parallel build cudf cpp with -DCPP_PARALLEL_LEVEL')
        // Put a default value for REF to avoid error when running the pipeline manually
        string(name: 'REF', defaultValue: 'main',
            description: 'Merged commit of specific PR')
        string(name: 'GITHUB_DATA', defaultValue: '',
            description: 'Json-formatted github data from upstream blossom-ci')
    }

    environment {
        JENKINS_ROOT = 'jenkins'
        GITHUB_TOKEN = credentials("github-token")

        ART_URL = "https://${common.ARTIFACTORY_NAME}/artifactory/sw-spark-maven"
        MVN_SETTINGS = 'ci/settings.xml'
        MVN_MIRROR = '-P mirror-apache-to-urm'
        ART_CREDS = credentials("urm_creds")
        ARTIFACTORY_NAME = "${common.ARTIFACTORY_NAME}"

        CUSTOM_WORKSPACE = "/home/jenkins/agent/workspace/${BUILD_TAG}"
    }

    stages {
        stage("Init githubHelper") {
            steps {
                script {
                    githubHelper = GithubHelper.getInstance("${GITHUB_TOKEN}", params.GITHUB_DATA)
                    // desc contains the PR ID and can be accessed from different builds
                    currentBuild.description = githubHelper.getBuildDescription()
                    try {
                        // quiet period here in case the first build of two close dup triggers has not set desc
                        sleep(time: 30, unit: "SECONDS")
                        // abort duplicate running builds of the same PR (based on build desc)
                        abortDupBuilds()
                    } catch (e) { // do not block following build if abort failure
                        echo "failed to try abort duplicate builds: " + e.toString()
                    }

                    def title = githubHelper.getIssue().title
                    if (title ==~ /.*\[skip ci\].*/) {
                        githubHelper.updateCommitStatus("", "Skipped", GitHubCommitState.SUCCESS)
                        currentBuild.result == "SUCCESS"
                        skipped = true
                        return
                    }
                }
            }
        } // end of Init githubHelper

        stage('Select CI images') {
            when {
                expression {
                    !skipped
                }
            }
            steps {
                script {
                    githubHelper.updateCommitStatus("", "Running", GitHubCommitState.PENDING)
                    checkout(
                        changelog: false,
                        poll: true,
                        scm: [
                            $class           : 'GitSCM', branches: [[name: githubHelper.getMergedSHA()]],
                            submoduleCfg     : [],
                            userRemoteConfigs: [[
                                                    credentialsId: 'github-token',
                                                    url          : githubHelper.getCloneUrl(),
                                                    refspec      : '+refs/pull/*/merge:refs/remotes/origin/pr/*']]
                        ]
                    )

                    // Keep common outside the source stash.
                    def helperRoot = pwd(tmp: true) + '/ci-image-common'
                    dir(helperRoot) {
                        checkout(changelog: false, poll: false, scm: [
                            $class: 'GitSCM', branches: [[name: '*/main']],
                            userRemoteConfigs: [[url: 'https://github.com/NVIDIA/spark-rapids-common.git',
                                refspec: '+refs/heads/main:refs/remotes/origin/main']],
                            extensions: [[$class: 'CloneOption', shallow: true, depth: 1,
                                noTags: true, honorRefspec: true, timeout: 10]]])
                    }
                    // Only main-targeting PRs may use main as a compatible fallback.
                    // A detached merge SHA or SNAPSHOT suffix cannot establish that policy.
                    def pr = readJSON(text: httpRequest(
                        url: "https://api.github.com/repos/NVIDIA/cudf-spark-jni/pulls/${githubHelper.getIssue().number}",
                        customHeaders: [[name: 'Authorization', value: "Bearer ${env.GITHUB_TOKEN}",
                            maskValue: true]],
                        validResponseCodes: '200', timeout: 60, quiet: true,
                        consoleLogResponseBody: false).content, returnPojo: true)
                    if (!(pr.base?.ref instanceof String) || !pr.base.ref) {
                        error 'GitHub did not return the PR target branch'
                    }
                    def allowMainFallback = pr.base.ref == 'main'
                    def imageSelections
                    withEnv(["CI_IMAGE_METADATA_HELPER=${helperRoot}/container-image/metadata.py"]) {
                        container('cpu') {
                            imageSelections = readJSON(text: sh(returnStdout: true,
                                script: 'python3 ci/image-config.py select --classifiers cuda12,cuda13' +
                                    (allowMainFallback ? ' --allow-main-fallback' : '')),
                                returnPojo: true)
                        }
                    }
                    // Temporary validation: require published images through the internal mirror.
                    // Do not build locally and hide a missing or incompatible mirrored image.
                    def images = resolveCiImages(imageSelections, [allowFallback: allowMainFallback])
                    IMAGE_PREMERGE_CU12 = images.cuda12
                    IMAGE_PREMERGE_CU13 = images.cuda13
                    stash(name: 'source_tree', includes: '**,.git/**', useDefaultExcludes: false)
                }
            }
        }

        stage("Determine Project Version") {
            when {
                expression {
                    !skipped
                }
            }

            steps {
                script {
                    unstash "source_tree"
                    def versions = readMavenPom(file: 'pom.xml').version.split('\\.')
                    major_ver = versions[0].toInteger()
                    minor_ver = versions[1].toInteger()
                }
            }
        }

        stage('Premerge Test') {
            when {
                beforeAgent true
                beforeOptions true
                expression {
                    !skipped
                }
            }
            failFast false
            parallel {
                stage ('cuda12') {
                    options {
                        lock(label: "${params.GPU_POOL}", quantity: 1, variable: 'GPU_RESOURCE')
                    }
                    agent {
                        kubernetes {
                            label "cu12-${BUILD_TAG}"
                            cloud "${common.CLOUD_NAME}"
                            yaml pod.getGPUYAML("${IMAGE_PREMERGE_CU12}", "${env.GPU_RESOURCE}", '10', '48Gi')
                            customWorkspace "${CUSTOM_WORKSPACE}-cu12"
                        }
                    }
                    environment {
                        CCACHE_BASEDIR = "${WORKSPACE}"
                    }

                    steps {
                        script {
                            unstash "source_tree"
                            container('gpu') {
                                timeout(time: 6, unit: 'HOURS') { // step only timeout for test run
                                    common.resolveIncompatibleDriverIssue(this)
                                    def jniVer = readMavenPom(file: 'pom.xml').version
                                    common.restoreJniCcache(this, jniVer, 'cuda12', 'ART_CREDS')
                                    try {
                                        runPremergeBuild()
                                        sh 'bash ci/fuzz-test.sh'
                                    } catch (e) {
                                        common.printJVMCoreDumps(this)
                                        common.uploadDebugBundle(this, 'cudf-spark-jni', 'cuda12')
                                        throw e
                                    }
                                }
                            }
                        }
                    }
                }

                stage ('cuda13') {
                    options {
                        lock(label: "cuda13", quantity: 1, variable: 'GPU_RESOURCE')
                    }
                    agent {
                        kubernetes {
                            label "cu13-${BUILD_TAG}"
                            cloud "${common.CLOUD_NAME}"
                            yaml pod.getGPUYAMLwithDriver("${IMAGE_PREMERGE_CU13}", "${env.GPU_RESOURCE}", '590.44.01', '10', '48Gi')
                            customWorkspace "${CUSTOM_WORKSPACE}-cu13"
                        }
                    }
                    environment {
                        CCACHE_BASEDIR = "${WORKSPACE}"
                    }

                    steps {
                        script {
                            unstash "source_tree"
                            container('gpu') {
                                timeout(time: 6, unit: 'HOURS') { // step only timeout for test run
                                    common.resolveIncompatibleDriverIssue(this)
                                    def jniVer = readMavenPom(file: 'pom.xml').version
                                    common.restoreJniCcache(this, jniVer, 'cuda13', 'ART_CREDS')
                                    try {
                                        runPremergeBuild()
                                        sh 'bash ci/fuzz-test.sh'
                                    } catch (e) {
                                        common.printJVMCoreDumps(this)
                                        common.uploadDebugBundle(this, 'cudf-spark-jni', 'cuda13')
                                        throw e
                                    }
                                }
                            }
                        }
                    }
                }

                stage ('sonarqube') {
                    steps {
                        script {
                            def prNumber = githubHelper.getIssue().number

                            def sonarBuild = build(
                                job: 'sonar-scan',
                                wait: true,
                                propagate: false,
                                parameters: [
                                    string(name: 'REPO_URL', value: githubHelper.getCloneUrl()),
                                    string(name: 'REF', value: githubHelper.getMergedSHA()),
                                    string(name: 'PR_KEY', value: prNumber.toString()),
                                    booleanParam(name: 'CHECK_QUALITY_GATE', value: true),
                                    booleanParam(name: 'MUTE_SLACK', value: true),
                                ])

                            if (sonarBuild.result == 'UNSTABLE') {
                                unstable('SonarQube Quality Gate failed')
                            } else if (sonarBuild.result != 'SUCCESS') {
                                error("SonarQube pipeline was ${sonarBuild.result}")
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (skipped) {
                    return
                }

                if (currentBuild.currentResult == "SUCCESS") {
                    githubHelper.updateCommitStatus("", "Success", GitHubCommitState.SUCCESS)
                } else {
                    // upload log only in case of build failure
                    def guardWords = [
                        "artifactory.*?\\.com",
                        "gitlab.*?\\.com",
                        "sonar.*?\\.com",
                        "urm.*?\\.com",
                    ]
                    guardWords.add("nvidia-smi(?s)(.*?)(?=git)") // hide GPU info
                    guardWords.add("sc-ipp*") // hide cloud info
                    githubHelper.uploadLogs(this, env.JOB_NAME, env.BUILD_NUMBER, null, guardWords)

                    githubHelper.updateCommitStatus("", "Fail", GitHubCommitState.FAILURE)
                }

            }
        }
    }
} // end of pipeline

void runPremergeBuild() {
    // CMake uses ~/.netrc to authenticate to the Apache mirror. Redact credentials
    // from failed downloads via cuDF CMake/libcurl CLI before Jenkins logs them.
    common.prepareArtNetrc(this)
    withEnv([
        "ARROW_THRIFT_MIRROR_URL=https://${env.ARTIFACTORY_NAME}/artifactory/sw-spark-apache-remote",
        "CMAKE_NETRC=OPTIONAL",
    ]) {
        common.shWithRedactedAuthorization(
            this,
            'source build/env.sh && ${sclCMD} "ci/premerge-build.sh"'
        )
    }
}

void abortDupBuilds() {
    Run prevBuild = currentBuild.rawBuild.getPreviousBuildInProgress()
    while (prevBuild != null) {
        if (prevBuild.isInProgress()) {
            def prevDesc = prevBuild.description?.trim()
            if (prevDesc && prevDesc == currentBuild.description?.trim()) {
                def prevExecutor = prevBuild.getExecutor()
                if (prevExecutor != null) {
                    echo "...Aborting duplicate Build #${prevBuild.number}"
                    prevExecutor.interrupt(Result.ABORTED,
                        new UserInterruption("Build #${currentBuild.number}"))
                }
            }
        }
        prevBuild = prevBuild.getPreviousBuildInProgress()
    }
}
