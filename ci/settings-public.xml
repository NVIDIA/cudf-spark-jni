  External CI reuses premerge-build.sh and fuzz-test.sh through MVN_SETTINGS.
  Mirror Central explicitly: dependency/plugin POMs can introduce their own Central
  repository and bypass the project's Google-first order. The POM's separate
  maven-central-fallback repository remains available if Google cannot serve an
  artifact. No profiles or internal credentials are needed here.
  Jenkins keeps settings.xml; local Maven retains the user's own settings.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <url>https://maven-central.storage-download.googleapis.com/maven2</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
