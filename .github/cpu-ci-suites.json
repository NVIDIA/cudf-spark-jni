{
  "shared_paths": [
    ".github/cpu-ci-suites.json",
    ".github/workflows/cpu-ci.yml"
  ],
  "suites": {
    "jni-images": {
      "enabled": true,
      "comment": "Validate JNI toolchain recipes and consumer inputs, not publisher/cleanup-only changes; product tests run in GPU CI.",
      "paths": [
        "pom.xml",
        "ci/Dockerfile",
        "ci/image-config.sh",
        "ci/image-config.py",
        "ci/image-smoke.sh",
        "ci/toolchains.json",
        ".github/image-builds.json"
      ],
      "jobs": [
        "jni-images"
      ]
    },
    "sonar-check": {
      "enabled": true,
      "comment": "Validate Sonar selection with mocked GitHub responses; no scan or internal runner is needed.",
      "paths": [
        ".github/scripts/sonar-check/",
        ".github/sonar-paths.json",
        ".github/workflows/sonar-check.yml"
      ],
      "exclude_paths": [".github/**/*.md"],
      "jobs": ["sonar-check"]
    }
  }
}
