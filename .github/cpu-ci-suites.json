{
  "shared_paths": [
    ".github/cpu-ci-suites.json",
    ".github/workflows/cpu-ci.yml"
  ],
  "suites": {
    "images": {
      "enabled": true,
      "comment": "Validate image inputs on PRs; existing JNI build/test coverage stays in Jenkins.",
      "paths": [
        "pom.xml",
        "ci/Dockerfile",
        "ci/image-config.sh",
        "ci/image-smoke.sh",
        "ci/toolchains.json",
        ".github/image-builds.json",
        ".github/workflows/image-build.yml"
      ],
      "jobs": [
        "images"
      ]
    }
  }
}
